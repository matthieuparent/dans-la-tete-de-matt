[Unit]
Description=Portfolio matthieuparent.com (Astro / Node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portfolio
Group=portfolio
WorkingDirectory=/srv/portfolio/app
EnvironmentFile=/srv/portfolio/shared/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4321
Environment=STATUS_DATA_DIR=/srv/portfolio/shared/data
ExecStart=/usr/bin/node ./dist/server/entry.mjs
Restart=on-failure
RestartSec=3
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/portfolio/shared/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
