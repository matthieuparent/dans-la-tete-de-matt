---
/** Icônes en points des sections (SVG statiques, cf. maquette Carnet : emblem()). */
import type { CarnetSection } from '../data/sections';

interface Props {
  section: CarnetSection;
  size?: number;
}
const { section, size = 28 } = Astro.props;

const d: Array<[number, number, number]> = [];
const add = (x: number, y: number, r = 1): void => void d.push([x, y, r]);
if (section === 'projets') ([[6, 12, 3], [14, 6, 4], [22, 13, 2.5]] as const).forEach(([x, y, r]) => add(x, y, r));
if (section === 'enseignement') {
  for (let x = 6; x <= 22; x += 3.2) { add(x, 2); add(x, 13); }
  for (let y = 5.6; y < 13; y += 3.6) { add(6, y); add(22, y); }
  for (let x = 2; x <= 26; x += 3) add(x, 17, 1.2);
}
if (section === 'jeu') {
  for (let a = 0; a < 360; a += 30) { const r = (a * Math.PI) / 180; add(14 + Math.cos(r) * 11, 10 + Math.sin(r) * 6.5); }
  add(8, 10, 1.6);
  add(20, 10, 1.6);
}
if (section === 'ia') ([[4, [5, 10, 15]], [14, [3, 8, 12, 17]], [24, [7, 13]]] as const).forEach(([x, ys]) => ys.forEach((y) => add(x, y, 1.4)));
if (section === 'famille') ([[4, 6], [10, 7], [16, 10], [21, 12], [25, 14]] as const).forEach(([x, top]) => { for (let y = top; y <= 18; y += 2.8) add(x, y, 1); });
---

<svg class="emblem" aria-hidden="true" width={size} height={(size * 20) / 28} viewBox="0 0 28 20">
  {d.map(([x, y, r]) => <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r={r} fill="currentColor" />)}
</svg>
