---
import { SECTIONS, isCarnetSection } from '../data/sections';
import ModeSwitch from './ModeSwitch.astro';
interface Props {
  mode: 'explorer' | 'lire';
  section?: string | undefined;
}
const { mode, section } = Astro.props;
---

<dialog class="menu" data-menu aria-label="Menu">
  <div class="menu__top">
    <a href="/" class="logo-box" aria-label="Matthieu Parent, accueil"><span aria-hidden="true">MP</span></a>
    <button type="button" class="menu__close" data-menu-close aria-label="Fermer le menu">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" stroke="currentColor" stroke-width="2"><line x1="2" y1="2" x2="16" y2="16"></line><line x1="16" y1="2" x2="2" y2="16"></line></svg>
    </button>
  </div>
  <nav aria-label="Sections">
    <ol role="list" class="menu__list">
      {SECTIONS.map((s) => (
        <li>
          <a href={s.id === 'carnet' ? '/carnet' : `/#${s.id}`} aria-current={section === s.id ? 'true' : undefined}>
            <span class="menu__num">{s.num}</span>
            <span class="menu__label">{s.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <div class="menu__bottom">
    <ModeSwitch {mode} section={section && isCarnetSection(section) ? section : undefined} />
    <a href="#contact">Contact</a>
  </div>
</dialog>
