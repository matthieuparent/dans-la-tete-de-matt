---
import { PROFILE } from '../data/sections';
const year = new Date().getFullYear();
// Anti-robots : le courriel est servi à l'envers dans des data-attributs et
// réassemblé côté client. Sans JS, on montre une forme lisible par un humain.
const rev = (v: string) => [...v].reverse().join('');
const { user, domain } = PROFILE.email;
const fallback = `${user} [arobase] ${domain.replace(/\./g, ' [point] ')}`;
---

<footer class="site-footer" id="contact">
  <div class="site-footer__brand">
    <p class="logo-long"><mark>Matthieu</mark> Parent</p>
    <p class="site-footer__tag">Dans la tête de <mark>Matt</mark> · {PROFILE.role.toLowerCase()}.</p>
  </div>
  <div class="site-footer__cols">
    <section aria-labelledby="f-contact">
      <h2 id="f-contact" class="eyebrow">Contact</h2>
      <p>{PROFILE.status}</p>
      <p><a class="sweep js-mail" href="#contact" data-u={rev(user)} data-d={rev(domain)}>{fallback}</a></p>
    </section>
    <nav aria-labelledby="f-nav">
      <h2 id="f-nav" class="eyebrow">Explorer</h2>
      <ul role="list">
        <li><a class="sweep" href="/#projets">Projets</a></li>
        <li><a class="sweep" href="/#enseignement">Enseignement</a></li>
        <li><a class="sweep" href="/#recharge">Recharge</a></li>
        <li><a class="sweep" href="/#ia">IA</a></li>
      </ul>
    </nav>
    <nav aria-labelledby="f-lire">
      <h2 id="f-lire" class="eyebrow">Lire</h2>
      <ul role="list">
        <li><a class="sweep" href="/carnet">Tous les articles</a></li>
        <li><a class="sweep" href="/rss.xml">Flux RSS</a></li>
      </ul>
    </nav>
  </div>
  <p class="site-footer__legal">
    <span class="legal-note" tabindex="0" aria-describedby="legal-note-tip">
      © {year} Matthieu Parent
      <span class="legal-note__tip" id="legal-note-tip" role="tooltip">
        Ce site a été pensé par l'expertise d'un humain et réalisé par l'IA.
      </span>
    </span>
  </p>
</footer>

<script>
  const rev = (v = '') => [...v].reverse().join('');
  const reveal = () => {
    document.querySelectorAll<HTMLAnchorElement>('a.js-mail[data-u]').forEach((a) => {
      const addr = `${rev(a.dataset.u)}@${rev(a.dataset.d)}`;
      a.href = `mailto:${addr}`;
      a.textContent = addr;
      a.removeAttribute('data-u');
    });
  };
  document.addEventListener('astro:page-load', reveal);
</script>
